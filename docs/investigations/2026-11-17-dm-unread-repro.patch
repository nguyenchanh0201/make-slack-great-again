@@ -1497,4 +1497,14 @@ TEST("slack read: stale snapshots do not restore unread over newer read or erase
     (void)ts100;
 }
 
+TEST("dm investigation: an explicit zero unread count is not inferred as one") {
+    model::Store store;
+    json::Document doc;
+    REQUIRE(doc.parse(std::string(R"({"id":"D1","is_im":true,"user":"UMIRA",
+        "last_read":"1800000000.000200","latest":{"ts":"1800000000.000300"},
+        "unread_count":0,"unread_count_display":0,"mention_count":0})"), nullptr));
+    const auto c = slack::mapjson::toConversation(doc.root(), store);
+    CHECK(c.unread == 0);
+}
